<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HypeTek CPU Power Control v0.1.6-storage-cleanup" Height="790" Width="1180"
        MinHeight="700" MinWidth="1050" WindowStartupLocation="CenterScreen"
        Background="#0B1220" Foreground="#E5E7EB" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#D1D5DB"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="HypeTek CPU Power Control" FontSize="28" FontWeight="SemiBold" Foreground="#60A5FA"/>
                <TextBlock Text="Windows CPU power profiles – by HypeTek" Foreground="#94A3B8"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnRefresh" Content="↻ Refresh"/>
                <Button x:Name="btnAbout" Content="Info / Kompatibilität"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#111827" BorderBrush="#263244" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,0,4,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="System" Foreground="#93C5FD" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtCpu" Text="CPU: …" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="txtOs" Text="Windows: …" Foreground="#CBD5E1"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Windows-Energieplan" Foreground="#93C5FD" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtScheme" Text="…" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <ComboBox x:Name="cmbPowerSchemes" Width="245" Margin="0,2,4,2" ToolTip="Alle von Windows gespeicherten Energiepläne, einschließlich eigener Pläne."/>
                        <Button x:Name="btnApplyPowerScheme" Content="Aktivieren" Padding="9,4" Margin="2"/>
                    </StackPanel>
                    <TextBlock x:Name="txtCurrentValues" Text="Werte: …" Margin="0,4,0,0" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kompatibilität" Foreground="#93C5FD" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtSupport" Text="Prüfe…" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Profile">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Ein Klick wendet ein Profil an. Rechtsklick: Bearbeiten / Duplizieren / Löschen." Foreground="#94A3B8" TextWrapping="Wrap" Margin="4,0,4,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnNew" Content="＋ Neues Profil"/>
                            <Button x:Name="btnFromCurrent" Content="Aktuelle Werte als Profil"/>
                            <Button x:Name="btnRestore" Content="↶ Letzte Werte" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="wrpProfiles" Margin="4"/>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Profil-Editor">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Name" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtProfileName" Width="320" Text="Neues Profil"/>
                            <CheckBox x:Name="chkApplyDC" Content="Akkubetrieb mit anwenden" Foreground="#D1D5DB" Margin="15,8,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Netzbetrieb (AC)" Foreground="#60A5FA" FontWeight="SemiBold" Margin="6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Akkubetrieb (DC)" Foreground="#60A5FA" FontWeight="SemiBold" Margin="6"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Max. Frequenz" ToolTip="MHz. 0 = kein zusätzliches Frequenzlimit."/>
                            <TextBox x:Name="numMaxFreqAC" Grid.Row="1" Grid.Column="1" Text="3900"/>
                            <TextBox x:Name="numMaxFreqDC" Grid.Row="1" Grid.Column="2" Text="3200"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Min. CPU-State (%)"/>
                            <TextBox x:Name="numMinStateAC" Grid.Row="2" Grid.Column="1" Text="5"/>
                            <TextBox x:Name="numMinStateDC" Grid.Row="2" Grid.Column="2" Text="5"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Max. CPU-State (%)"/>
                            <TextBox x:Name="numMaxStateAC" Grid.Row="3" Grid.Column="1" Text="100"/>
                            <TextBox x:Name="numMaxStateDC" Grid.Row="3" Grid.Column="2" Text="90"/>

                            <Label Grid.Row="4" Grid.Column="0" Content="Turbo / Boost"/>
                            <ComboBox x:Name="cmbBoostAC" Grid.Row="4" Grid.Column="1"/>
                            <ComboBox x:Name="cmbBoostDC" Grid.Row="4" Grid.Column="2"/>

                            <Label Grid.Row="5" Grid.Column="0" Content="Kühlungsrichtlinie"/>
                            <ComboBox x:Name="cmbCoolingAC" Grid.Row="5" Grid.Column="1"/>
                            <ComboBox x:Name="cmbCoolingDC" Grid.Row="5" Grid.Column="2"/>

                            <Label Grid.Row="6" Grid.Column="0" Content="EPP (%)" ToolTip="Energy Performance Preference: 0 = Leistung, 100 = Effizienz. Nicht auf jeder CPU wirksam."/>
                            <TextBox x:Name="numEppAC" Grid.Row="6" Grid.Column="1" Text="25"/>
                            <TextBox x:Name="numEppDC" Grid.Row="6" Grid.Column="2" Text="60"/>
                        </Grid>

                        <TextBlock Text="Hinweis: Nicht unterstützte Windows-Power-Settings werden beim Anwenden übersprungen. Firmware/CPU können einzelne Limits dennoch ignorieren." Foreground="#FBBF24" TextWrapping="Wrap" Margin="6,8"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="btnSaveProfile" Content="💾 Profil speichern"/>
                            <Button x:Name="btnApplyEditor" Content="▶ Werte jetzt anwenden" Background="#164E63" BorderBrush="#0891B2"/>
                        </StackPanel>

                        <Expander Header="Erweiterte Informationen / Live-Ausführung" Foreground="#93C5FD" Margin="6,10,6,4">
                            <StackPanel>
                                <TextBlock Text="Letzte Profil-Ausführung" Foreground="#A7F3D0" FontWeight="SemiBold" Margin="4,2,4,4"/>
                                <TextBox x:Name="txtExecutionLog" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" Height="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                <TextBlock Text="Die App schreibt über die Windows Power Policy API. Das Live-Protokoll zeigt jeden Schreibvorgang und den jeweils äquivalenten powercfg-Befehl." Foreground="#94A3B8" TextWrapping="Wrap" Margin="4,4,4,10"/>
                                <TextBlock Text="Editor-Vorschau" Foreground="#93C5FD" FontWeight="SemiBold" Margin="4,2,4,4"/>
                                <TextBox x:Name="txtCommandPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" Height="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                <TextBlock Text="Diese Vorschau gehört nur zu den aktuell im Profil-Editor eingetragenen Werten und wird nicht als Befehl ausgeführt." Foreground="#94A3B8" TextWrapping="Wrap" Margin="4"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <Border Grid.Row="3" Background="#111827" CornerRadius="6" Padding="8" Margin="4,10,4,0">
            <DockPanel>
                <TextBlock x:Name="txtStatus" Text="Bereit." Foreground="#A7F3D0"/>
                <TextBlock DockPanel.Dock="Right" Text="Nutzung auf eigene Gefahr · keine BIOS-/Spannungsänderungen" Foreground="#94A3B8" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
